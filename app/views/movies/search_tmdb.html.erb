<h1>Search in TMDb</h1>

<div class="my-3">
  <%# Part 1 here: fill in the route and method this form submits with, and give it the id tmdb_form %>
  <%= form_tag search_tmdb_path, method: :get, id: 'tmdb_form' do %>
    <%= label_tag 'movie_title_field', 'Movie Name', class: 'form-label' %>
    <%= text_field_tag 'title', params[:title], class: 'form-control', id: 'movie_title_field', placeholder: 'Manhunter' %>
    <%= label_tag 'movie_year_field', 'Release Year', class: 'form-label' %>
    <%= text_field_tag 'release_year', params[:release_year], class: 'form-control', id: 'movie_year_field', placeholder: '1986' %>

    <div class="form-check">
      <%= radio_button_tag 'language', 'en', params[:language] != 'all', class: 'form-check-input' %>
      <%= label_tag 'language_en', 'English Only', class: 'form-check-label' %>
    </div>
    <div class="form-check">
      <%= radio_button_tag 'language', 'all', params[:language] == 'all', class: 'form-check-input' %>
      <%= label_tag 'language_all', 'All Languages', class: 'form-check-label' %>
    </div>

    <%= submit_tag 'Search', id: 'tmdb_submit', class: 'btn btn-warning' %>
    <%# Part 1 here: add a button that takes the user back to the movie list %>
    <%= link_to 'Back to Movie List', movies_path, class: 'btn btn-secondary' %>
  <% end %>
</div>

<%# Part 5 here: show the search results in a table with id search_movies %>
<% unless @movies.nil? %>
  <table id="search_movies" class="table table-striped table-hover">
    <caption class="visually-hidden">Search results from TMDb.</caption>
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Release Date</th>
        <th scope="col">Rating</th>
        <th scope="col">Overview</th>
        <th scope="col">Add Movie</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.release_date %></td>
          <td><%= movie.rating %></td>
          <td class="text-truncate" style="max-width: 30rem;"><%= movie.description %></td>
          <td>
            <%= form_tag add_movie_path, method: :post do %>
              <%= hidden_field_tag 'movie[title]', movie.title %>
              <%= hidden_field_tag 'movie[rating]', movie.rating %>
              <%= hidden_field_tag 'movie[description]', movie.description %>
              <%= hidden_field_tag 'movie[release_date]', movie.release_date %>
              <%= submit_tag 'Add Movie', class: 'btn btn-primary' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
